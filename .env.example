# ==============================================================================
# Environment Configuration
# All primary workflows run locally without any external API keys (100% Free)
# ==============================================================================

# Random Seed for Reproducibility
RANDOM_SEED=42

# Data Paths
RAW_DATA_PATH=data/raw/twcs.csv
PROCESSED_DATA_DIR=data/processed
SPLITS_DIR=data/splits
GOLDEN_SET_PATH=data/golden/golden_set.json

# Model & Embeddings Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
DEVICE=cpu

# Escalation Policy Thresholds (Validation-Tuned Defaults)
INTENT_CONFIDENCE_THRESHOLD=0.70
RETRIEVAL_SIMILARITY_THRESHOLD=0.65

# Optional LLM Judge / Generation (Fallback runs locally via HuggingFace or heuristic)
# Set to 'local' for local HuggingFace / rules, or provide optional API key if experimenting
LLM_PROVIDER=local
LOCAL_MODEL_NAME=google/flan-t5-base
# OPTIONAL_OPENAI_API_KEY=
